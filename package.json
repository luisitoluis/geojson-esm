{
  "name": "geojson.js",
  "version": "0.0.1",
  "description": "Turn plain JS objects into GeoJSON. Modern ESM port of GeoJSON.js v0.4.1 with the same parse behavior.",
  "packageManager": "pnpm@11.21.0",
  "author": "luisitoluis",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "files": [
    "src/index.js"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [
    "geojson",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisitoluis/geojson.js.git"
  },
  "bugs": {
    "url": "https://github.com/luisitoluis/geojson.js/issues"
  },
  "homepage": "https://github.com/luisitoluis/geojson.js",
  "devDependencies": {
    "oxlint": "1.86.0",
    "vitest": "4.1.11"
  }
}
