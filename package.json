{
  "name": "geojson-modern",
  "version": "0.1.0",
  "description": "Turn plain JS objects into GeoJSON. A modernized ESM reimplementation of the classic geojson package.",
  "packageManager": "pnpm@11.9.0",
  "author": "Luis (LuisitoLuis)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "geojson",
    "feature",
    "featurecollection",
    "geo",
    "gis",
    "geospatial",
    "coordinates",
    "parser",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisitoLuis/geojson.js-modern.git"
  },
  "bugs": {
    "url": "https://github.com/LuisitoLuis/geojson.js-modern/issues"
  },
  "homepage": "https://github.com/LuisitoLuis/geojson.js-modern#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "4.1.9"
  }
}
