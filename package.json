{
  "name": "geojson-modern",
  "version": "0.1.0",
  "description": "Turn plain JS objects into GeoJSON. A modernized ESM reimplementation of the classic geojson package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["geojson", "geo", "gis", "parser", "esm"],
  "author": "Luis (LuisitoLuis)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisitoLuis/geojson-modern.git"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsup": "8.5.1",
    "vitest": "3.2.6"
  }
}
